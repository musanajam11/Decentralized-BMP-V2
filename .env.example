# ===== Decentralized-BMP V2 =====
# Copy this file to .env and edit the values. Never commit .env to git.

# --- Core ---
# Public origin browsers/clients use to reach the backend (scheme + host).
# Multiple comma-separated origins allowed.
PUBLIC_ORIGIN=https://backend.yourdomain.xyz
ALLOWED_ORIGINS=https://backend.yourdomain.xyz

# --- Auth ---
# 32+ random bytes, base64. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Initial admin account created on first boot if no users exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_LOGIN

# Default number of server keys a brand-new (non-admin) user may mint.
# Admins can override per-user from the dashboard.
DEFAULT_KEY_ALLOTMENT=1

# --- OAuth (optional — leave blank to disable) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://backend.yourdomain.xyz

# --- BeamMP version negotiation ---
LAUNCHER_VERSION=2.7.0
SERVER_VERSION=3.9.1
COMPAT_PROFILE=v2_7_0

# --- Publishing (BMR — BeamNG Mod Registry public backends index) ---
# When PUBLISH_ENABLED=true and BMR_API_KEY is set, this backend pushes a
# heartbeat to BMR every 60 s so it shows up in Content Manager's backend
# picker. When off, the backend is still reachable directly at PUBLIC_ORIGIN
# — publishing is purely about discoverability.
PUBLISH_ENABLED=false
BMR_URL=https://bmr.musanet.xyz
# Issued by BMR when you register your backend (planned: bmr.musanet.xyz UI).
BMR_API_KEY=
# Public-facing display info sent in each heartbeat.
PUBLISH_DISPLAY_NAME=My Decentralized BMP
PUBLISH_REGION=us-east
PUBLISH_DESCRIPTION=Self-hosted BeamMP backend.

# --- Patched-binary runtime config ---
# Read by the patched BeamMP-Server / BeamMP-Launcher binaries at runtime.
# Auto-derived from PUBLIC_ORIGIN by entrypoint.sh if left unset, but
# pinning them explicitly here is safer (and required for any operator
# launching the binaries outside this container).
BMP_BACKEND_HOST=backend.yourdomain.xyz
BMP_BACKEND_URL=https://backend.yourdomain.xyz

# One-shot: force re-download of /data/builds/* from the rolling
# binaries-latest release on the next container start. Useful after
# the build-binaries workflow publishes a new build. Unset (or set to
# 0) for normal operation so existing files are kept.
# BUILDS_FORCE_REFETCH=1

